//Menu of Restaurant 1
#include<stdio.h>
void Menu();
void BurgerMenu();
void BarBQMenu();
void PizzaMenu();
void RollMenu();
void JuiceMenu();
void IceCreamMenu();

float totalPrice = 0;

int main(){
    int choice;

    while(1){
        Menu();
        printf("\nEnter your choice : ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                BurgerMenu();
                break;
            case 2:
                BarBQMenu();
                break;
            case 3:
                PizzaMenu();
                break;
            case 4:
                RollMenu();
                break;
            case 5:
                JuiceMenu();
                break;
            case 6:
                IceCreamMenu();
                break;
            case 7:
                printf("\nTotal Order Prize : %.2f\n", totalPrice);
                return 0;
            default:
                printf("Invalid choice - Try Again \n\n\n");
        } 
    }
    return 0;
}

